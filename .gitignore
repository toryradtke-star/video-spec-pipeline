# Media: footage, generated stills, voiceover reads and renders.
# Regenerable or too large for Git — this repo tracks the pipeline, not its output.
*.mp4
*.mov
*.wav
*.mp3
*.png
*.jpg
*.jpeg
*.webp

# ...except the scrim overlays, which are pipeline *inputs* that render_social needs.
!_assets/*.png

# ffmpeg vidstab transform files — regenerated by stab.py / stab_social.py
*.trf

# Local footage and brand assets, wherever VSP_* points at them by default
/footage/
/overlays/
/_strips/

# Generated beside a page
pages/*/jobs.json
pages/*/social/*_jobs.json

# Measured grade cache — regenerated per clip, and keyed to a specific library
pages/_grades.json

# Python
__pycache__/
*.pyc
